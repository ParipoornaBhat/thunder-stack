# Database Settings
# Supports Supabase, Aiven, Neon, AWS RDS, or local PostgreSQL:
# - Local Docker: postgresql://postgres:postgres@localhost:5432/thunder_db
# - Supabase / Neon: postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?sslmode=require
# - Aiven PostgreSQL: postgresql://avnadmin:[PASSWORD]@[HOST]:[PORT]/defaultdb?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/thunder_db"

# Better Auth Configuration
BETTER_AUTH_SECRET="some_super_secret_32_characters_long_key"

# Server & Frontend URL Configuration
# Single Server URL for Backend (automatically processed for Hono, Next.js, and Expo)
SERVER_URL="http://localhost:4000"

# Address of Next.js / Web frontend(s). Supports comma-separated URLs (e.g. "http://localhost:3000,https://app.example.com")
CLIENT_URL="http://localhost:3000"
NEXT_PUBLIC_IS_DOCS_ONLY="false" # Set to true for live Docs site deployments (Vercel/Cloudflare)

# Google OAuth Config (Obtain from Google Cloud Console)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Expo Mobile Google OAuth Config (For client-side/native authentication)
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB="your-expo-web-client-id.apps.googleusercontent.com"
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS="your-expo-ios-client-id.apps.googleusercontent.com"
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID="your-expo-android-client-id.apps.googleusercontent.com"

# SMTP / Nodemailer Configuration (Gmail App Password)
SMTP_EMAIL="your-email@gmail.com"
SMTP_APP_PASSWORD="your-gmail-app-password"
SMTP_NAME="THUNDER Stack"

# Cloudflare Credentials (Optional: For headless/CI deployments without browser login)
# CLOUDFLARE_API_TOKEN="your-cloudflare-api-token"
# CLOUDFLARE_ACCOUNT_ID="your-cloudflare-account-id"
# HYPERDRIVE_ID="your-cloudflare-hyperdrive-id"

