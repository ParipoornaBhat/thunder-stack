{
  "name": "thunder-stack",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.0",
  "scripts": {
    "prepare": "node scripts/setup-env.js",
    "dev": "pnpm db:seed && turbo run dev",
    "build": "pnpm db:seed && turbo run build",
    "start": "turbo run start --filter=!mobile",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @thunder/db db:generate",
    "db:migrate": "pnpm --filter @thunder/db db:migrate",
    "db:seed": "pnpm --filter @thunder/db db:seed",
    "migrate:generate": "pnpm --filter @thunder/db db:generate --name",
    "migrate:deploy": "pnpm --filter @thunder/db db:migrate",
    "clean": "node scripts/clean.js",
    "clean:install": "node scripts/clean.js && pnpm install",
    "ci": "pnpm run clean:install",
    "native": "cross-env EXPO_NO_METRO_LAZY=1 pnpm --filter mobile start --clear"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "turbo": "2.10.4"
  }
}