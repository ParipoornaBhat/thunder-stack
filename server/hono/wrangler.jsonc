{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thunder-server",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "dev": {
    "ip": "0.0.0.0",
    "port": 4000
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "NODE_ENV": "development"
  }
}