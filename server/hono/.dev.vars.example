# Database Settings
# Supports Supabase, Aiven, Neon, AWS RDS, or local PostgreSQL:
# - Local Docker: postgresql://postgres:postgres@localhost:5432/thunder_db
# - Supabase / Neon: postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?sslmode=require
# - Aiven PostgreSQL: postgresql://avnadmin:[PASSWORD]@[HOST]:[PORT]/defaultdb?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/thunder_db"

# Better Auth Configuration
BETTER_AUTH_SECRET="your-better-auth-secret-min-32-characters"
BETTER_AUTH_URL="http://localhost:4000"

# Frontend Configuration
CLIENT_URL="http://localhost:3000"
NEXT_PUBLIC_SERVER_URL="http://localhost:4000"
EXPO_PUBLIC_SERVER_URL="http://localhost:4000"

# Google OAuth Config
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Expo Mobile Google OAuth Config
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB="your-google-client-id-for-web"
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS="your-expo-ios-client-id"
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID="your-expo-android-client-id"

# Email Configuration (SMTP)
SMTP_APP_PASSWORD=""
SMTP_EMAIL=""
SMTP_NAME="THUNDER Stack"
