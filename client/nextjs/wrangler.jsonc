{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thunder-web",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "pages_build_output_dir": ".open-next/.deploy",
  "vars": {
    "NODE_ENV": "production",
    "NEXT_PUBLIC_SERVER_URL": "http://localhost:4000",
    "NEXT_PUBLIC_IS_DOCS_ONLY": "\"false\" # Set to true for live Docs site deployments (Vercel/Cloudflare)"
  }
}
